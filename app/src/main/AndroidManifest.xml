<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <!-- food-log: nutrition records, asked on first food use only. -->
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <!-- owner-profile: the owner's height (asked when a height is first saved). -->
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" />
    <!-- weight-export: read weights older than 30 days (asked only when exporting). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Scale broadcast (scale-weigh-in): scanning only, never used for location. CONNECT is
         needed only for the system "turn Bluetooth on" dialog. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- background-weigh-in: re-arm the listen trial after a phone restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- background-weigh-in: a notification after every automatic weigh-in (asked when the switch is turned on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Labels of the apps that write weights to Health Connect (the list's source column). -->
    <queries>
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.health.openscale" />
        <package android:name="nl.appyhapps.healthsync" />
    </queries>

    <application
        android:name=".TerveysApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terveyslappu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Weigh-in dialog: own task, not in recents, so the main screen never shows behind it. -->
        <activity
            android:name=".WeighInActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/weighin_title"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Terveyslappu.WeighIn" />

        <service
            android:name=".WeighInTileService"
            android:exported="true"
            android:icon="@drawable/ic_scale"
            android:label="@string/weighin_action"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".WeighInWidget"
            android:exported="true"
            android:label="@string/weighin_action">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weigh_in_widget" />
        </receiver>

        <!-- background-weigh-in: the listen trial's scan results and alarms (our PendingIntents only). -->
        <receiver
            android:name=".listen.ListenReceiver"
            android:exported="false" />

        <!-- background-weigh-in: Poista and Hyväksy from a weigh-in notification (our PendingIntents only). -->
        <receiver
            android:name=".auto.AutoActionReceiver"
            android:exported="false" />

        <!-- background-weigh-in: re-arms the trial after boot and app updates. -->
        <receiver
            android:name=".listen.ListenBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Health Connect shows this when the user asks why the app wants access. -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
