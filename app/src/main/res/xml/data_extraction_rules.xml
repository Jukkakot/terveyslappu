<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app is backed up: weights live in Health Connect, the log stays on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
