{
  "permissions": {
    "allow": [
      "Bash(openspec *)",
      "Bash(git *)",
      "Bash(./gradlew *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 900
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/openspec-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
